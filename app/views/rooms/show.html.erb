<h2>施設詳細</h2>

<% content_for :header_search do %>
  <%= render "shared/search_form", show_area: true %>
<% end %>
<%= link_to "← 戻る", :back, class: "back-btn" %>

<div class= "room-detail">
  <div class= "room-image">
    <% if @room.image.attached? %>
      <%= image_tag @room.image %>
    <% end %>
  </div>

  <div class= "room-info">
    <div class= "room-header">
      <h2><%= @room.name %></h2>
      <div class= "room-price">
        <%= number_to_currency(@room.price, unit: "¥", precision: 0) %>
      </div>
    </div>

    <p class= "room-intro">
      <%= @room.introduction %>
    </p>

    <div class= "room-reservation">
      <%= form_with model: [@room, @reservation],
        url: confirm_room_reservations_path(@room),
        method: :post,
        local: true,
        data:{turbo: false} do |f| %>
        <div>
          <%= f.label :check_in, "チェックイン" %>
          <%= f.date_field :check_in %>
        </div>

        <div>
          <%= f.label :check_out, "チェックアウト" %>
          <%= f.date_field :check_out %>
        </div>

        <div>
          <%= f.label :people, "人数" %>
          <%= f.number_field :people %>
        </div>

        <%= f.submit "予約する", class: "btn"%>
      <% end %>
    </div>
  </div>
</div>
