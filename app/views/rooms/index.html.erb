<h1>施設一覧</h1>

<%= link_to "ルーム投稿", new_room_path, class: "btn" %>

<table>
    <tr>
      <th>画像</th>
      <th>施設名</th>
      <th>紹介文</th>
      <th>料金</th>
      <th>作成日</th>
    </tr>

  <% @rooms.each do |room| %>
    <tr>
      <td>
        <% if room.image.attached? %>
          <%= image_tag room.image, class: "room-thumb" %>
        <% else %>
         <%= image_tag "default_room.png", class: "room-thumb" %>
        <% end %>
      </td>
      <td><%= link_to room.name, room_path(room) %></td>
      <td><%= truncate(room.introduction, length: 40) %></td>
      <td><p class="room-price"> <%= number_to_currency(room.price, unit: "¥", precision: 0) %></p></td>
      <td><%= room.created_at.strftime("%Y/%m/%d") %></td>
    </tr>
  <% end %>
</table>
