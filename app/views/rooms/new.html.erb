<div class= "room-form-container">
  <h2>新規施設登録</h2>

  <%= form_with model: @room, local: true do |f| %>

    <table>
      <tr>
        <th><%= f.label :name, "ルーム名" %></th>
        <td><%= f.text_field :name %></td>
      </tr>

      <tr>
        <th><%= f.label :introduction, "紹介" %></th>
        <td><%= f.text_area :introduction %></td>
      </tr>

      <tr>
        <th><%= f.label :price, "料金" %></th>
        <td><%= f.number_field :price %></td>
      </tr>

      <tr>
        <th><%= f.label :address, "住所" %></th>
        <td><%= f.text_field :address %></td>
      </tr>

      <tr>
        <th><%= f.label :image, "画像" %></th>
        <td><%= f.file_field :image %></td>
      </tr>

      <tr>
        <td colspan="2"><%= f.submit "投稿する", class: "btn" %></td>

      </tr>
      <tr>
        <td colspan="2"><%= link_to "キャンセル", :back, class: "cancel-btn" %></td>
      </tr>
    </table>

  <% end %>
</div>
